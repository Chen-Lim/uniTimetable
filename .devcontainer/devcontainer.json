{
  "name": "uniTimetable (Rust)",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "codespaces": {
      "idleTimeoutMinutes": 240
    }
  },
  "postCreateCommand": "rustup component add clippy rustfmt",
  "remoteEnv": {
    "RUST_BACKTRACE": "1"
  }
}
